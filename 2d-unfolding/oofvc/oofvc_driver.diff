+OOFVC_KEYS = ("entry", "reco_pt", "reco_pz", "true_pt", "true_pz", "w_reco", "w_truth")  # OOFVC
+
+
+def load_oofvc_rows(path):  # OOFVC
+    """The join's moved rows (OOFVC-DECLARATION.md section 1.3): one per nu_mu CC mc_background entry whose true
+    muon is in the grid; entry, reco and true (pT, p||), reco-mode and truth-mode weights before the POT scale."""
+    with np.load(path, allow_pickle=False) as z:
+        if sorted(z.files) != sorted(OOFVC_KEYS):
+            raise RuntimeError(f"[FAIL] OOFVC: {path} keys {sorted(z.files)} are not {sorted(OOFVC_KEYS)}")
+        rows = {k: np.asarray(z[k]) for k in OOFVC_KEYS}
+    n = rows["entry"].size
+    if rows["entry"].dtype != np.int64 or any(rows[k].dtype != np.float64 or rows[k].shape != (n,)
+                                              for k in OOFVC_KEYS[1:]):
+        raise RuntimeError("[FAIL] OOFVC: the rows must be int64 entries and float64 columns of one length")
+    if np.unique(rows["entry"]).size != n or (n and rows["entry"].min() < 0):
+        raise RuntimeError("[FAIL] OOFVC: the entries must be distinct and non-negative")
+    # w_truth is used only by rows appended to the signal, whose weight rule (0 <= w < 1e4) drops a non-finite one,
+    # as the signal loader drops its own; every other column must be finite (codex-school r2 #3)
+    if not all(np.all(np.isfinite(rows[k])) for k in OOFVC_KEYS[1:] if k != "w_truth"):
+        raise RuntimeError("[FAIL] OOFVC: a moved row has a non-finite value")
+    return rows
+
+
+def append_oofvc_rows(rows, pot_scale, pt_lo, pt_hi, pz_lo, pz_hi, lists):  # OOFVC
+    """Append the moved rows reconstructed in a cell of the grid as selected signal (pass_reco and pass_truth true;
+    the truth gate is the grid only: MINERvA's numerator has no phase-space cut). Return the ones reconstructed
+    outside it, which are not appended, as truth (pT, p||) and POT-scaled reco weight (N's second source), with the
+    counts. Cells are ROOT's: lower edges in, upper edges out, as the binned M, T and O. Weights follow the loaders'
+    own rules: an appended row needs the signal loader's 0 <= w < 1e4 on both weights, a row reconstructed outside
+    needs the background loader's 0 <= w_reco < 1e6; a row failing its rule is dropped and counted, as those loaders
+    drop theirs."""
+    tpt, tpz, rpt, rpz, prc, ptr, wtl, wrl, sel = lists
+    outside = {"truth_pt": [], "truth_pz": [], "w_reco": []}
+    counts = {"appended": 0, "outside": 0, "dropped_appended_weight": 0, "dropped_outside_weight": 0}
+    for r_pt, r_pz, t_pt, t_pz, w_r, w_t in zip(rows["reco_pt"], rows["reco_pz"], rows["true_pt"],
+                                                 rows["true_pz"], rows["w_reco"], rows["w_truth"]):
+        r_pt, r_pz, t_pt, t_pz, w_r, w_t = map(float, (r_pt, r_pz, t_pt, t_pz, w_r, w_t))
+        if not (pt_lo <= t_pt < pt_hi and pz_lo <= t_pz < pz_hi):
+            raise RuntimeError("[FAIL] OOFVC: a moved row's true muon is outside the grid's cells")
+        if pt_lo <= r_pt < pt_hi and pz_lo <= r_pz < pz_hi:
+            if not (0 <= w_t < 1e4 and 0 <= w_r < 1e4):
+                counts["dropped_appended_weight"] += 1
+                continue
+            tpt.append(t_pt); tpz.append(t_pz); rpt.append(r_pt); rpz.append(r_pz)
+            prc.append(True); ptr.append(True)
+            wtl.append(w_t * pot_scale); wrl.append(w_r * pot_scale); sel.append(True)
+            counts["appended"] += 1
+        else:
+            if not (0 <= w_r < 1e6):
+                counts["dropped_outside_weight"] += 1
+                continue
+            outside["truth_pt"].append(t_pt); outside["truth_pz"].append(t_pz)
+            outside["w_reco"].append(w_r * pot_scale)
+            counts["outside"] += 1
+    print(f"[INFO] OOFVC: {counts}")
+    out = {k: np.asarray(v, dtype=float) for k, v in outside.items()}
+    out["counts"] = counts
+    return out
