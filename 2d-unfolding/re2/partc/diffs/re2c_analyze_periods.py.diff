+def parse_arm(argv):
+    """Strip [--arm refined --work-cov PATH SHA256] [--ns DIR] from argv and set the pins; returns the rest."""
+    argv = list(argv)
+    arm, wc, ns = "purity", None, None
+    if "--arm" in argv:
+        i = argv.index("--arm")
+        arm = argv[i + 1]
+        del argv[i:i + 2]
+    if "--work-cov" in argv:
+        i = argv.index("--work-cov")
+        wc = (argv[i + 1], argv[i + 2])
+        del argv[i:i + 3]
+    if "--ns" in argv:
+        i = argv.index("--ns")
+        ns = argv[i + 1]
+        del argv[i:i + 2]
+    PD.set_arm(arm, work_cov=wc, ns=ns)
+    return argv
+
