+PTMC_RECORD = {}  # PTMC: the draw and completeness records of the last main() run (read by the paired runner)
 
 
+def _ptmc_truth_vector(pt, pz, w, pt_edges, pz_edges):  # PTMC
+    """Sum of w per truth cell, flattened [pT][p||], with a TH2D's cell rule (lower edges in, upper edges out)."""
+    ex, ey = np.asarray(pt_edges, float), np.asarray(pz_edges, float)
+    ix = np.searchsorted(ex, np.asarray(pt, float), side="right") - 1
+    iy = np.searchsorted(ey, np.asarray(pz, float), side="right") - 1
+    nx, ny = ex.size - 1, ey.size - 1
+    ok = (ix >= 0) & (ix < nx) & (iy >= 0) & (iy < ny)
+    return np.bincount(ix[ok] * ny + iy[ok], weights=np.asarray(w, float)[ok], minlength=nx * ny)
+
+
+def ptmc_completeness_2d(sig, w_truth_cv, n_appended, pt_edges, pz_edges, truth_denom):  # PTMC
+    """PTMC-DECLARATION.md section 2.2: the completeness of an R bootstrap replica, resampled consistently.
+    c*_j = (T*_orig,j + T*_moved,j) / D*_j with D*_j = D_CV,j * T*_orig,j / T_orig,CV,j: T is the summed w_truth of
+    the truth-passing signal rows (the original rows, or the appended ones, which are the last n_appended), * the
+    resampled weights (sig) and CV the un-resampled ones (w_truth_cv). With nothing appended it is c_CV exactly.
+    A cell with T_orig,CV,j = 0 keeps c_CV,j (ROOT's Divide value); a cell with T_orig,CV,j > 0 and T*_orig,j = 0 has
+    D*_j = 0, so c*_j = 0 and the extraction gives 0 there, as production's replica does (its U*_j is 0); both are
+    counted."""
+    n = sig["w_truth"].shape[0]
+    if w_truth_cv.shape[0] != n or not 0 <= n_appended <= n:
+        raise RuntimeError("[FAIL] PTMC: the completeness arrays do not line up")
+    pt_ok = np.asarray(sig["pass_truth"], bool)
+    orig = np.arange(n) < n - n_appended
+    tp, tz = sig["truth_pt"], sig["truth_pz"]
+    t_star_all = _ptmc_truth_vector(tp[pt_ok], tz[pt_ok], sig["w_truth"][pt_ok], pt_edges, pz_edges)
+    t_star_orig = _ptmc_truth_vector(tp[pt_ok & orig], tz[pt_ok & orig], sig["w_truth"][pt_ok & orig],
+                                     pt_edges, pz_edges)
+    t_cv_orig = _ptmc_truth_vector(tp[pt_ok & orig], tz[pt_ok & orig], w_truth_cv[pt_ok & orig], pt_edges, pz_edges)
+    h_cv, h_in_cv, h_den = compute_omnifold_completeness_2d(dict(sig, w_truth=w_truth_cv), pt_edges, pz_edges,
+                                                            truth_denom)
+    nx, ny = len(pt_edges) - 1, len(pz_edges) - 1
+    d_cv = np.array([h_den.GetBinContent(ix, iy) for ix in range(1, nx + 1) for iy in range(1, ny + 1)])
+    c_cv = np.array([h_cv.GetBinContent(ix, iy) for ix in range(1, nx + 1) for iy in range(1, ny + 1)])
+    lost = (t_cv_orig > 0) & (t_star_orig == 0)
+    keep = t_cv_orig == 0
+    c_star = c_cv.copy()
+    c_star[lost] = 0.0
+    live = ~keep & ~lost
+    d_star = d_cv[live] * t_star_orig[live] / t_cv_orig[live]
+    with np.errstate(divide="ignore", invalid="ignore"):
+        c_star[live] = np.where(d_star != 0, t_star_all[live] / d_star, 0.0)
+    if not np.all(np.isfinite(c_star)):
+        raise RuntimeError("[FAIL] PTMC: a non-finite replica completeness")
+    h = h_cv.Clone("hOFCompleteness2D")
+    for g in range(nx * ny):
+        h.SetBinContent(g // ny + 1, g % ny + 1, float(c_star[g]))
+    h_in = h_in_cv.Clone("hOFInputTruth2D")
+    for g in range(nx * ny):
+        h_in.SetBinContent(g // ny + 1, g % ny + 1, float(t_star_all[g]))
+    PTMC_RECORD["completeness"] = {"c_star": c_star.tolist(), "n_keep_cv": int(keep.sum()),
+                                   "n_lost_support": int(lost.sum()), "n_appended": int(n_appended)}
+    print(f"[INFO] PTMC: R replica completeness resampled consistently ({int(keep.sum())} cells keep c_CV, "
+          f"{int(lost.sum())} lost their original-row support and give 0)")
+    return h, h_in, h_den
+
