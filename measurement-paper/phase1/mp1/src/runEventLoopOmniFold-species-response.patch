+  // also needs MNV101_SPECIES_RESPONSE_FTABLE (the playlist's tabulated F).
+  bool speciesResponseEnabled = false;
+  species_response::Q0Convention speciesQ0 = species_response::Q0Convention::kFPropagation;
+  species_response::FuzzConvention speciesFuzz = species_response::FuzzConvention::kProRata;
+  std::string speciesResponseError;
+  if(!ParseSpeciesResponseConventions(getenv("MNV101_SPECIES_RESPONSE_Q0"),
+                                      getenv("MNV101_SPECIES_RESPONSE_FUZZ"),
+                                      speciesResponseEnabled, speciesQ0, speciesFuzz,
+                                      speciesResponseError))
+  {
+    std::cerr << "Invalid species-response setting: " << speciesResponseError << "\n";
+    return badCmdLine;
+  }
+  const char* speciesFTable = getenv("MNV101_SPECIES_RESPONSE_FTABLE");
+  const bool speciesFTableSet = speciesFTable != nullptr && std::string(speciesFTable).size() > 0;
+  if(speciesFTableSet != (speciesResponseEnabled && speciesQ0 == species_response::Q0Convention::kFPropagation))
+  {
+    std::cerr << "MNV101_SPECIES_RESPONSE_FTABLE must be set exactly when MNV101_SPECIES_RESPONSE_Q0=fprop.\n";
