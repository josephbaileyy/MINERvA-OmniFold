+// Parse MNV101_SPECIES_RESPONSE_Q0 / _FUZZ (MP1-A S0; BINDING-PHASE1-ADDENDUM-2
+// R1-R2). Both unset or empty: no SpeciesResponse band is constructed and the
+// event loop is unchanged. Otherwise both must be set: Q0 in {fprop, fractional,
+// legacy}, FUZZ in {prorata, none, all}.
+inline bool ParseSpeciesResponseConventions(const char* q0Val, const char* fuzzVal,
+                                            bool& enabled,
+                                            species_response::Q0Convention& q0conv,
+                                            species_response::FuzzConvention& fuzzconv,
+                                            std::string& error)
+{
+  const std::string q0Text = q0Val ? q0Val : "";
+  const std::string fuzzText = fuzzVal ? fuzzVal : "";
+  enabled = !q0Text.empty() || !fuzzText.empty();
+  if(!enabled) return true;
+  if(q0Text == "fprop") q0conv = species_response::Q0Convention::kFPropagation;
+  else if(q0Text == "fractional") q0conv = species_response::Q0Convention::kFractional;
+  else if(q0Text == "legacy") q0conv = species_response::Q0Convention::kLegacyAbsolute;
+  else
+  {
+    error = "MNV101_SPECIES_RESPONSE_Q0 must be 'fprop', 'fractional' or 'legacy', got '" + q0Text + "'";
+    return false;
+  }
+  if(fuzzText == "prorata") fuzzconv = species_response::FuzzConvention::kProRata;
+  else if(fuzzText == "none") fuzzconv = species_response::FuzzConvention::kNone;
+  else if(fuzzText == "all") fuzzconv = species_response::FuzzConvention::kAll;
+  else
+  {
+    error = "MNV101_SPECIES_RESPONSE_FUZZ must be 'prorata', 'none' or 'all', got '" + fuzzText + "'";
     return false;
   }
   return true;
