+// Parse MNV101_RECOIL_RESPONSE_DELTA (publication packet W2). Unset or empty:
+// no RecoilResponse band is constructed and the event loop is unchanged.
+// Otherwise it must be a finite, non-negative fraction below 1, e.g. "0.04".
+inline bool ParseRecoilResponseDelta(const char* envVal, bool& enabled,
+                                     double& delta, std::string& error)
+{
+  enabled = false;
+  delta = 0.0;
+  if(envVal == nullptr || std::string(envVal).empty()) return true;
+  const std::string text(envVal);
+  try
+  {
+    size_t used = 0;
+    const double parsed = std::stod(text, &used);
+    if(used != text.size() || !std::isfinite(parsed) || parsed < 0.0 || parsed >= 1.0)
+    {
+      error = "expected a finite fraction in [0, 1), got '" + text + "'";
+      return false;
+    }
+    enabled = true;
+    delta = parsed;
+  }
+  catch(const std::exception&)
+  {
+    error = "not a number: '" + text + "'";
+    return false;
+  }
+  return true;
+}
