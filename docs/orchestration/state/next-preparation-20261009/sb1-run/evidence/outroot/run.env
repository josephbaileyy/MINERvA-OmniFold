sb1_check_env() {
  local h
  h="$( (sha256sum "${SB1_ENV_SETUP}" 2>/dev/null || shasum -a 256 "${SB1_ENV_SETUP}") | cut -d' ' -f1)"
  if [[ "${h}" != "${SB1_ENV_SETUP_SHA256}" ]]; then
    echo "[sb1] REFUSED: ${SB1_ENV_SETUP} changed since submission" >&2
    return 3
  fi
}
