+// Reco-muon momentum/selection dump (gated, MNV101_DUMP_MUONQ): per-event MINOS
+// track momentum estimators, fit flags and angles so selection and momentum
+// variants can be recomputed offline. Added to mc_signal_reco, mc_background and
+// data only when the flag is set; unset, no branch is booked and no value read.
+// Every field is -9999 on rows with no reco muon (sim_pass false, truth-only
+// misses), exactly like sim/sim_pz. Read in reco mode from the CV universe.
+struct RecoMuonQDump
+{
+  double mu_p_total, mu_p_minos, mu_trk_p, mu_trk_p_range, mu_trk_p_curv;
+  int    mu_used_range, mu_used_curv, mu_trk_quality;
+  double mu_trk_qp, mu_trk_eqp_qp, mu_mad_p, mu_thetaX, mu_thetaY, mu_theta;
+
+  RecoMuonQDump() { Reset(); }
+
+  void Reset()
+  {
+    mu_p_total = mu_p_minos = mu_trk_p = mu_trk_p_range = mu_trk_p_curv = -9999.0;
+    mu_used_range = mu_used_curv = mu_trk_quality = -9999;
+    mu_trk_qp = mu_trk_eqp_qp = mu_mad_p = -9999.0;
+    mu_thetaX = mu_thetaY = mu_theta = -9999.0;
+  }
+
+  void Book(TTree* out)
+  {
+    out->Branch("mu_p_total",     &mu_p_total);      // MeV, GetPmu()
+    out->Branch("mu_p_minos",     &mu_p_minos);      // MeV, GetPmuMinos()
+    out->Branch("mu_trk_p",       &mu_trk_p);        // MeV, MINOS trk p
+    out->Branch("mu_trk_p_range", &mu_trk_p_range);  // MeV, MINOS range p
+    out->Branch("mu_trk_p_curv",  &mu_trk_p_curv);   // MeV, MINOS curvature p
+    out->Branch("mu_used_range",  &mu_used_range);   // MINOS used-range flag
+    out->Branch("mu_used_curv",   &mu_used_curv);    // MINOS used-curvature flag
+    out->Branch("mu_trk_quality", &mu_trk_quality);  // MINOS track quality
+    out->Branch("mu_trk_qp",      &mu_trk_qp);       // MINOS q/p
+    out->Branch("mu_trk_eqp_qp",  &mu_trk_eqp_qp);   // MINOS sigma(q/p)/(q/p)
+    out->Branch("mu_mad_p",       &mu_mad_p);        // MeV, <AnaTool>_muon_P
+    out->Branch("mu_thetaX",      &mu_thetaX);       // rad
+    out->Branch("mu_thetaY",      &mu_thetaY);       // rad
+    out->Branch("mu_theta",       &mu_theta);        // rad, GetThetamu()
+  }
+
+  // Rebind already-booked branches (AppendTruthOnlyMisses: the booking
+  // function's locals have gone out of scope).
+  void Bind(TTree* out)
+  {
+    out->SetBranchAddress("mu_p_total",     &mu_p_total);
+    out->SetBranchAddress("mu_p_minos",     &mu_p_minos);
+    out->SetBranchAddress("mu_trk_p",       &mu_trk_p);
+    out->SetBranchAddress("mu_trk_p_range", &mu_trk_p_range);
+    out->SetBranchAddress("mu_trk_p_curv",  &mu_trk_p_curv);
+    out->SetBranchAddress("mu_used_range",  &mu_used_range);
+    out->SetBranchAddress("mu_used_curv",   &mu_used_curv);
+    out->SetBranchAddress("mu_trk_quality", &mu_trk_quality);
+    out->SetBranchAddress("mu_trk_qp",      &mu_trk_qp);
+    out->SetBranchAddress("mu_trk_eqp_qp",  &mu_trk_eqp_qp);
+    out->SetBranchAddress("mu_mad_p",       &mu_mad_p);
+    out->SetBranchAddress("mu_thetaX",      &mu_thetaX);
+    out->SetBranchAddress("mu_thetaY",      &mu_thetaY);
+    out->SetBranchAddress("mu_theta",       &mu_theta);
+  }
+
+  void Read(const CVUniverse* u)
+  {
+    const std::string tool = u->GetAnaToolName();
+    mu_p_total     = u->GetPmu();
+    mu_p_minos     = u->GetPmuMinos();
+    mu_trk_p       = u->GetDouble((tool + "_minos_trk_p").c_str());
+    mu_trk_p_range = u->GetDouble((tool + "_minos_trk_p_range").c_str());
+    mu_trk_p_curv  = u->GetDouble((tool + "_minos_trk_p_curvature").c_str());
+    // Flags read with GetInt, as IsMinosMatchMuon reads _minos_trk_is_ok.
+    mu_used_range  = u->GetInt((tool + "_minos_used_range").c_str());
+    mu_used_curv   = u->GetInt((tool + "_minos_used_curvature").c_str());
+    mu_trk_quality = u->GetInt((tool + "_minos_trk_quality").c_str());
+    mu_trk_qp      = u->GetDouble((tool + "_minos_trk_qp").c_str());
+    mu_trk_eqp_qp  = u->GetDouble((tool + "_minos_trk_eqp_qp").c_str());
+    mu_mad_p       = u->GetDouble((tool + "_muon_P").c_str());
+    mu_thetaX      = u->GetDouble("muon_thetaX");
+    mu_thetaY      = u->GetDouble("muon_thetaY");
+    mu_theta       = u->GetThetamu();
+  }
+};
