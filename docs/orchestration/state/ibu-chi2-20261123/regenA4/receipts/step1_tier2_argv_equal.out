== tier2.sh tension arm 1 (normalized)
CWD OUT
ARG W/docs/orchestration/state/2d-closeout/stageF/methods/note-figstyle-20261117/tools/capture_palette.py
ARG CAP
ARG W/docs/orchestration/state/2d-closeout/stageF/methods/note-figstyle-20261117/tools/palette_run.py
ARG W/docs/orchestration/state/2d-closeout/stageF/methods/note-figstyle-20261117/tools/remap_anc.py
ARG /Users/josephbailey/cov2d-work/figfetch/anc
ARG W/2d-unfolding/diagnose_tension.py
ARG --ours
ARG /Users/josephbailey/cov2d-work/figfetch/er-anc/xsec.root
ARG --out-prefix
ARG OUT/tension
ARG --style
ARG restyle-2026-10
ARG --print-font
ENV HOME=HOME
