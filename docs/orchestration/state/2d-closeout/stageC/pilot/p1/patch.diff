+# ---------------------------------------------------------------------------
+# P1 diagnostic (stage package only): background-MC Poisson(1) stream
+# ---------------------------------------------------------------------------
+P1_STREAMS = ("three", "bkg")
+P1_BKG_SEED_OFFSET = 20_000_000  # data: seed; signal MC: seed + 10_000_000
+
+
+def p1_draw_bkg_factors(bootstrap_seed, n_entries):
+    """Poisson(1) factor per mc_background tree entry, drawn over ALL entries
+    before any selection (the PET convention), from its own sub-RNG."""
+    rng = np.random.default_rng(int(bootstrap_seed) + P1_BKG_SEED_OFFSET)
+    return rng.poisson(1.0, size=int(n_entries)).astype(float)
+
+
+def p1_refill_bkg_2d(name, title, rows, b_bkg, pt_edges, pz_edges):
+    """B*: refill the background TH2D as sum b_bkg[entry] * w_pot, in the
+    production fill order (overflow rows included). With b_bkg == 1 every
+    Fill gets the production weight bit for bit."""
+    h = make_th2d(name, title, pt_edges, pz_edges)
+    for pt, pz, wp, e in zip(rows["pt"], rows["pz"], rows["w_pot"], rows["entry"]):
+        h.Fill(float(pt), float(pz), float(b_bkg[int(e)]) * float(wp))
+    return h
 
 
