+// RDX (F1.2(i), MNV101_DUMP_TRUTHX): the leading final-state proton's kinetic
+// energy (MeV), or 0 if there is none: the largest mc_FSPartE - 938.272 over
+// mc_FSPartPDG == 2212 (GetNProtonsTrue's mass and rule), read through
+// GetTruthFSHadrons, which keeps protons with mc_FSPartE unchanged.
+inline double RdxLeadingProtonKE(const CVUniverse* u)
+{
+  std::vector<double> E, px, py, pz;
+  std::vector<int> pdg;
+  u->GetTruthFSHadrons(E, px, py, pz, pdg);
+  double best = 0.0;
+  for(size_t i = 0; i < pdg.size(); ++i)
+    if(pdg[i] == 2212 && E[i] - 938.272 > best) best = E[i] - 938.272;
+  return best;
+}
